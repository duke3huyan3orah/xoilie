# Runtime
NODE_ENV=development
XOILIE_LOG_LEVEL=info
XOILIE_OUTPUT_DIR=exports
XOILIE_DEVELOPMENT_MODE=false
XOILIE_BYPASS=false

# Provider selection. Phase 0 ships deterministic mock providers only.
XOILIE_LLM_PROVIDER=mock-llm
XOILIE_IMAGE_PROVIDER=mock-image
XOILIE_VIDEO_PROVIDER=mock-video
XOILIE_AUDIO_PROVIDER=mock-audio
XOILIE_VISION_PROVIDER=mock-vision
XOILIE_UPSCALER_PROVIDER=mock-upscaler

# Optional model overrides
# XOILIE_LLM_MODEL=
# XOILIE_IMAGE_MODEL=
# XOILIE_VIDEO_MODEL=
# XOILIE_AUDIO_MODEL=

# Future provider credentials belong in an untracked .env file. Provider
# adapters must document their own variable names and must never log values.
# EXAMPLE_PROVIDER_API_KEY=
